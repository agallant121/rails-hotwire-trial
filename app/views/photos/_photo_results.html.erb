<div id="photo-results">
  <section class="photo-grid" aria-label="All photos">
    <%= render photos, liked_photo_ids: liked_photo_ids %>
  </section>

  <% if pagy.pages > 1 %>
    <nav class="pagination" aria-label="Photo pages">
      <% if pagy.previous %>
        <%= link_to "Previous", photos_path(page: pagy.previous), data: { turbo_stream: true }, class: "pagination-link" %>
      <% else %>
        <span class="pagination-link disabled">Previous</span>
      <% end %>

      <span class="pagination-status">Page <%= pagy.page %> of <%= pagy.pages %></span>

      <% if pagy.next %>
        <%= link_to "Next", photos_path(page: pagy.next), data: { turbo_stream: true }, class: "pagination-link" %>
      <% else %>
        <span class="pagination-link disabled">Next</span>
      <% end %>
    </nav>
  <% end %>
</div>
