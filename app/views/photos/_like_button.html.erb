<%= turbo_frame_tag dom_id(photo, :like) do %>
  <% if current_user.likes.exists?(photo: photo) %>
    <%= button_to photo_like_path(photo), method: :delete, class: "like-button liked" do %>
      <%= image_tag "star-fill.svg", alt: "", class: "like-icon" %>
      <span><%= photo.likes_count %></span>
    <% end %>
  <% else %>
    <%= button_to photo_like_path(photo), method: :post, class: "like-button" do %>
      <%= image_tag "star-line.svg", alt: "", class: "like-icon" %>
      <span><%= photo.likes_count %></span>
    <% end %>
  <% end %>
<% end %>
