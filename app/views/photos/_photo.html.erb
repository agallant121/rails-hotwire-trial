<article id="<%= dom_id(photo) %>" class="photo-card">
  <%= image_tag photo.medium_url, alt: photo.alt.presence || "Photo by #{photo.photographer}", class: "photo-image" %>

  <div class="photo-content">
    <div class="photo-details">
      <h2><%= photo.photographer %></h2>

      <%= link_to photo.source_url, class: "source-link", target: "_blank", rel: "noopener", aria: { label: "View source photo by #{photo.photographer}" } do %>
        <%= image_tag "links.svg", alt: "", class: "source-icon" %>
        <span>Source</span>
      <% end %>
    </div>

    <%= render "photos/like_button", photo: photo %>
  </div>
</article>
