<section class="auth-card">
  <div class="auth-brand">
    <%= image_tag "logo.svg", alt: "Clever", class: "auth-logo" %>
    <h1>Sign in</h1>
  </div>

  <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "auth-form" }) do |form| %>
    <div class="field">
      <%= form.label :email %>
      <%= form.email_field :email, autofocus: true, autocomplete: "email" %>
    </div>

    <div class="field">
      <%= form.label :password %>
      <%= form.password_field :password, autocomplete: "current-password" %>
    </div>

    <% if devise_mapping.rememberable? %>
      <div class="checkbox-field">
        <%= form.check_box :remember_me %>
        <%= form.label :remember_me %>
      </div>
    <% end %>

    <%= form.submit "Sign in", class: "button auth-submit" %>
  <% end %>
</section>
